{
    "version": 2,
    "builds": [
      {
        "src": "server.js",
        "use": "@vercel/node"
      },
      {
        "src": "*.html",
        "use": "@vercel/static"
      },
      {
        "src": "*.css",
        "use": "@vercel/static"
      },
      {
        "src": "*.js",
        "use": "@vercel/static"
      }
    ],
    "routes": [
      {
        "src": "/api/(.*)",
        "dest": "/server.js"
      },
      {
        "src": "/(.*)\\.css$",
        "headers": {
          "Content-Type": "text/css"
        },
        "dest": "/$1.css"
      },
      {
        "src": "/(.*)\\.js$",
        "headers": {
          "Content-Type": "application/javascript"
        },
        "dest": "/$1.js"
      },
      {
        "src": "/(.*)",
        "dest": "/index.html"
      }
    ]
  }